/** 全局样式：起飞蓝青配色 + 饱和打击同构的战术终端观感 */

page {
  --bg: #0f1419;
  --surface: #1a2332;
  --surface2: #243044;
  --border: #334155;
  --text: #e2e8f0;
  --muted: #94a3b8;
  --accent: #38bdf8;
  --accent-dim: #0ea5e9;
  --success: #4ade80;
  --danger: #f87171;
  --radius: 4rpx;

  background-color: var(--bg);
  background-image:
    linear-gradient(rgba(56, 189, 248, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(56, 189, 248, 0.035) 1px, transparent 1px);
  background-size: 56rpx 56rpx;
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.5;
  font-family: Courier New, monospace;
  box-sizing: border-box;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 8rpx 4rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 24rpx;
}

.page-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--muted);
  margin-bottom: 20rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  gap: 16rpx;
}

.card-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.card-tag {
  color: var(--accent);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.output-summary {
  color: var(--accent);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  text-align: right;
  flex-shrink: 0;
}

.stat-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.stat {
  flex: 1; min-width: 180rpx; background: var(--surface2); border: 1rpx solid var(--border);
  padding: 16rpx;
}
.stat .k { color: var(--muted); font-size: 18rpx; letter-spacing: 2rpx; text-transform: uppercase; }
.stat .v { color: var(--accent); font-size: 40rpx; margin-top: 8rpx; }
.stat .v.ok { color: var(--success); }
.stat .v.danger { color: var(--danger); }
.stat .v.accent { color: var(--accent); }

.stale-banner {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #fbbf24;
  border: 1rpx solid rgba(251, 191, 36, 0.45);
  background: rgba(251, 191, 36, 0.08);
}
.details-toggle {
  color: var(--muted);
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.field-error {
  display: block;
  color: var(--danger);
  font-size: 20rpx;
  margin-top: 8rpx;
}
.field-input.invalid { border-color: var(--danger); }
.back-to-top {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 40;
  padding: 12rpx 20rpx;
  background: var(--surface);
  color: var(--accent);
  border: 1rpx solid var(--accent);
  font-size: 22rpx;
}

.card-hint {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.65;
  margin-top: 16rpx;
}

.field-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.field-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--surface2);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 26rpx;
  font-family: Courier New, monospace;
}

.field-input.readonly {
  color: var(--muted);
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--surface2);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 26rpx;
  font-family: Courier New, monospace;
}

.picker-arrow {
  color: var(--muted);
  font-size: 22rpx;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn {
  flex: 1;
  min-width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  border: none;
  padding: 0;
  margin: 0;
  font-family: Courier New, monospace;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--accent);
  color: #042033;
}

.btn-primary[disabled] {
  background: #1e4a63;
  color: #0a2030;
  opacity: 1;
}

.btn-secondary {
  background: transparent;
  color: var(--text);
  border: 1rpx solid var(--border);
}

.status-bar {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  background: var(--surface2);
  color: var(--muted);
  border: 1rpx solid var(--border);
  font-family: Courier New, monospace;
}

.status-bar.ok {
  color: var(--success);
  border-color: rgba(74, 222, 128, 0.35);
}

.status-bar.error {
  color: var(--danger);
  border-color: rgba(248, 113, 113, 0.35);
}

.status-bar.loading {
  color: var(--accent);
  border-color: rgba(56, 189, 248, 0.35);
}

.output-pre {
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text);
  font-family: Courier New, monospace;
  max-height: 480rpx;
  overflow-y: auto;
  background: #0d1117;
  border: 1rpx solid var(--border);
  padding: 16rpx;
}

.output-pre.empty {
  color: var(--muted);
}

.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: var(--radius);
  background: rgba(56, 189, 248, 0.12);
  color: var(--accent);
  margin-left: 8rpx;
  border: 1rpx solid var(--border);
  letter-spacing: 1rpx;
}

.grid-3 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-3 .grid-item {
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
}

.page-footer {
  padding: 16rpx 8rpx 8rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
  line-height: 1.6;
  opacity: 0.7;
}
