.ski-grid {
  margin-top: 16rpx;
}

.hardpoints-block {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.12);
}

.hardpoints-title {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.hardpoints-station {
  margin-bottom: 16rpx;
}

.hardpoints-station-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.hardpoints-station-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.hardpoints-station-limit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  font-family: monospace;
}

.hardpoints-station-stores {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.72);
}

.hardpoints-fixed {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 8rpx;
}
