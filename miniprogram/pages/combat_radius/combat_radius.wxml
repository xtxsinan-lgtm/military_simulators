<view class="cr-page">
  <view class="cr-header">
    <text class="cr-title">飞机作战半径估算终端</text>
    <text class="cr-sub">COMBAT RADIUS · L/D + THRUST + TSFC + BREGUET</text>
  </view>

  <view class="panel">
    <view class="panel-head">1. 升阻比估算 · L/D</view>
    <view class="note">用两架已知巡航 L/D 的锚点标定 (Cf0, k_e)，再估算第三型机。ISA 11–20 km。</view>

    <view class="section cyan">▸ 锚点 1</view>
    <view class="field">
      <view class="field-label"><text>机型预设</text></view>
      <picker mode="selector" range="{{presetNames}}" value="{{a1PresetIndex}}" data-slot="a1" bindchange="onPreset">
        <view class="picker-val">{{presetNames[a1PresetIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>已知巡航 L/D</text><text class="unit">目标</text></view>
      <input class="input" type="digit" value="{{a1Ld}}" data-key="a1Ld" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>展弦比 AR</text></view>
      <input class="input" type="digit" value="{{a1.AR}}" data-slot="a1" data-key="AR" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>前缘后掠角</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{a1.sweep_deg}}" data-slot="a1" data-key="sweep_deg" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼载荷</text><text class="unit">t/m²</text></view>
      <input class="input" type="digit" value="{{a1.wing_loading}}" data-slot="a1" data-key="wing_loading" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>厚弦比 tc</text></view>
      <input class="input" type="digit" value="{{a1.tc}}" data-slot="a1" data-key="tc" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>马赫数</text></view>
      <input class="input" type="digit" value="{{a1.mach}}" data-slot="a1" data-key="mach" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>高度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{a1.alt_m}}" data-slot="a1" data-key="alt_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼型</text></view>
      <picker mode="selector" range="{{planformNames}}" value="{{a1PlanformIndex}}" data-slot="a1" bindchange="onPlanform">
        <view class="picker-val">{{planformNames[a1PlanformIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>布局</text></view>
      <picker mode="selector" range="{{layoutNames}}" value="{{a1LayoutIndex}}" data-slot="a1" bindchange="onLayout">
        <view class="picker-val">{{layoutNames[a1LayoutIndex]}}</view>
      </picker>
    </view>
    <view class="check-row">
      <label><switch checked="{{a1.bwb}}" data-slot="a1" data-key="bwb" bindchange="onSwitch"/> 翼身融合</label>
      <label><switch checked="{{a1.rough}}" data-slot="a1" data-key="rough" bindchange="onSwitch"/> 表面不平整</label>
    </view>

    <view class="section amber">▸ 锚点 2</view>
    <view class="field">
      <view class="field-label"><text>机型预设</text></view>
      <picker mode="selector" range="{{presetNames}}" value="{{a2PresetIndex}}" data-slot="a2" bindchange="onPreset">
        <view class="picker-val">{{presetNames[a2PresetIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>已知巡航 L/D</text><text class="unit">目标</text></view>
      <input class="input" type="digit" value="{{a2Ld}}" data-key="a2Ld" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>展弦比 AR</text></view>
      <input class="input" type="digit" value="{{a2.AR}}" data-slot="a2" data-key="AR" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>前缘后掠角</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{a2.sweep_deg}}" data-slot="a2" data-key="sweep_deg" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼载荷</text><text class="unit">t/m²</text></view>
      <input class="input" type="digit" value="{{a2.wing_loading}}" data-slot="a2" data-key="wing_loading" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>厚弦比 tc</text></view>
      <input class="input" type="digit" value="{{a2.tc}}" data-slot="a2" data-key="tc" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>马赫数</text></view>
      <input class="input" type="digit" value="{{a2.mach}}" data-slot="a2" data-key="mach" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>高度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{a2.alt_m}}" data-slot="a2" data-key="alt_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼型</text></view>
      <picker mode="selector" range="{{planformNames}}" value="{{a2PlanformIndex}}" data-slot="a2" bindchange="onPlanform">
        <view class="picker-val">{{planformNames[a2PlanformIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>布局</text></view>
      <picker mode="selector" range="{{layoutNames}}" value="{{a2LayoutIndex}}" data-slot="a2" bindchange="onLayout">
        <view class="picker-val">{{layoutNames[a2LayoutIndex]}}</view>
      </picker>
    </view>
    <view class="check-row">
      <label><switch checked="{{a2.bwb}}" data-slot="a2" data-key="bwb" bindchange="onSwitch"/> 翼身融合</label>
      <label><switch checked="{{a2.rough}}" data-slot="a2" data-key="rough" bindchange="onSwitch"/> 表面不平整</label>
    </view>

    <view class="section green">▸ 待估机型</view>
    <view class="field">
      <view class="field-label"><text>机型预设</text></view>
      <picker mode="selector" range="{{presetNames}}" value="{{tgtPresetIndex}}" data-slot="tgt" bindchange="onPreset">
        <view class="picker-val">{{presetNames[tgtPresetIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>展弦比 AR</text></view>
      <input class="input" type="digit" value="{{tgt.AR}}" data-slot="tgt" data-key="AR" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>前缘后掠角</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{tgt.sweep_deg}}" data-slot="tgt" data-key="sweep_deg" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼载荷</text><text class="unit">t/m²</text></view>
      <input class="input" type="digit" value="{{tgt.wing_loading}}" data-slot="tgt" data-key="wing_loading" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>厚弦比 tc</text></view>
      <input class="input" type="digit" value="{{tgt.tc}}" data-slot="tgt" data-key="tc" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>马赫数</text></view>
      <input class="input" type="digit" value="{{tgt.mach}}" data-slot="tgt" data-key="mach" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>高度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.alt_m}}" data-slot="tgt" data-key="alt_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼型</text></view>
      <picker mode="selector" range="{{planformNames}}" value="{{tgtPlanformIndex}}" data-slot="tgt" bindchange="onPlanform">
        <view class="picker-val">{{planformNames[tgtPlanformIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>布局</text></view>
      <picker mode="selector" range="{{layoutNames}}" value="{{tgtLayoutIndex}}" data-slot="tgt" bindchange="onLayout">
        <view class="picker-val">{{layoutNames[tgtLayoutIndex]}}</view>
      </picker>
    </view>
    <view class="check-row">
      <label><switch checked="{{tgt.bwb}}" data-slot="tgt" data-key="bwb" bindchange="onSwitch"/> 翼身融合</label>
      <label><switch checked="{{tgt.rough}}" data-slot="tgt" data-key="rough" bindchange="onSwitch"/> 表面不平整</label>
    </view>
    <view class="field">
      <view class="field-label"><text>翼面积</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{tgt.wing_area_m2}}" data-slot="tgt" data-key="wing_area_m2" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>马赫角</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{tgt.mach_angle_deg}}" data-slot="tgt" data-key="mach_angle_deg" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机身长度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.length_m}}" data-slot="tgt" data-key="length_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼展</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.wingspan_m}}" data-slot="tgt" data-key="wingspan_m" bindinput="onAcField"/>
    </view>

    <view class="btn" bindtap="onRun">▶ 估算升阻比</view>
  </view>

  <view class="panel">
    <view class="panel-head">2. 军推估算 · THRUST</view>
    <view class="note">理想 Brayton 双涵道循环：T4 全包线保持，海平面静止军推反标定换算流量。概念设计级估算。</view>
    <view class="field">
      <view class="field-label"><text>发动机预设</text></view>
      <picker mode="selector" range="{{engineNames}}" value="{{enginePresetIndex}}" bindchange="onEnginePreset">
        <view class="picker-val">{{engineNames[enginePresetIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>涵道比 BPR</text></view>
      <input class="input" type="digit" value="{{engBpr}}" data-key="engBpr" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>总压比 OPR</text></view>
      <input class="input" type="digit" value="{{engOpr}}" data-key="engOpr" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>涡轮前温度 T4</text><text class="unit">K</text></view>
      <input class="input" type="digit" value="{{engT4}}" data-key="engT4" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>海平面军推</text><text class="unit">kN</text></view>
      <input class="input" type="digit" value="{{engTsl}}" data-key="engTsl" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>海平面加力</text><text class="unit">kN</text></view>
      <input class="input" type="digit" value="{{engMaxTsl}}" data-key="engMaxTsl" placeholder="最大速度用" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>高度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{engAlt}}" data-key="engAlt" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>马赫数</text></view>
      <input class="input" type="digit" value="{{engMach}}" data-key="engMach" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>压气机效率 η_c</text></view>
      <input class="input" type="digit" value="{{engEta}}" data-key="engEta" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>风扇压比</text><text class="unit">可空</text></view>
      <input class="input" type="digit" value="{{engFanPr}}" data-key="engFanPr" placeholder="由 BPR 估算" bindinput="onField"/>
    </view>
    <view class="btn" bindtap="onRunThrust">▶ 估算可用军推</view>
  </view>

  <view class="panel">
    <view class="panel-head">3. 负载与巡航效率 · TSFC</view>
    <view class="note">空战重量 = 空重 + 一半内油 + 飞行员×0.1 t + 4 枚中距弹。D=W/(L/D)，负载=D/可用军推。巡航点用第 2 栏高度/马赫。</view>
    <view class="field">
      <view class="field-label"><text>空重</text><text class="unit">kg</text></view>
      <input class="input" type="digit" value="{{wtEmpty}}" data-key="wtEmpty" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>内油</text><text class="unit">kg</text></view>
      <input class="input" type="digit" value="{{wtFuel}}" data-key="wtFuel" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>飞行员数</text></view>
      <input class="input" type="number" value="{{wtPilots}}" data-key="wtPilots" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>单枚中距弹</text><text class="unit">kg</text></view>
      <input class="input" type="digit" value="{{wtMissile}}" data-key="wtMissile" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>挂弹数</text></view>
      <input class="input" type="number" value="{{wtNMissiles}}" data-key="wtNMissiles" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>发动机台数</text></view>
      <input class="input" type="number" value="{{wtEngines}}" data-key="wtEngines" bindinput="onField"/>
    </view>
    <view class="check-row">
      <label><switch checked="{{wtCarrier}}" bindchange="onCarrierSwitch"/> 舰载机（降落冗余 40 min / 陆基 30 min）</label>
    </view>
    <view class="field">
      <view class="field-label"><text>部件效率 ε</text></view>
      <input class="input" type="digit" value="{{effEps}}" data-key="effEps" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>喷管效率 η_n</text></view>
      <input class="input" type="digit" value="{{effEtan}}" data-key="effEtan" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>附件功提取比例</text></view>
      <input class="input" type="digit" value="{{effAcc}}" data-key="effAcc" bindinput="onField"/>
    </view>
    <view class="btn" bindtap="onRunEfficiency">▶ 估算负载与 TSFC</view>
  </view>

  <view class="panel">
    <view class="panel-head">4. 作战半径 · RANGE</view>
    <view class="note">搜索 L/D×η_o 最大且阻力 ≤ 军推 92% 的高度，布雷盖估算作战半径。马赫角优先用预设度数。降落冗余、爬升额外与降落节省一律按亚音速油耗入账（即使巡航点是超音速）。</view>
    <view class="btn" bindtap="onRunRadius">▶ 估算作战半径</view>
  </view>

  <view class="panel">
    <view class="panel-head">5. 最大速度 · Vmax</view>
    <view class="note">加力平飞：各高度二分最大马赫（阻力 ≤ 加力 92%），取真速最大点。使用海平面加力标定，不计作战半径。</view>
    <view class="btn" bindtap="onRunMaxSpeed">▶ 估算最大速度</view>
  </view>

  <view class="panel">
    <view class="panel-head">升阻比输出 · OUTPUT</view>
    <view class="note">{{statusText}}</view>
    <block wx:if="{{result}}">
      <view class="stat-row">
        <view class="stat"><view class="k">待估 L/D</view><view class="v">{{resultLd}}</view><view class="sub">{{result.target.name}}</view></view>
        <view class="stat"><view class="k">Cf0</view><view class="v amber">{{resultCf0}}</view></view>
        <view class="stat"><view class="k">k_e</view><view class="v amber">{{resultKe}}</view></view>
      </view>
      <view class="tr th">
        <text class="th">机型</text><text class="th">L/D</text><text class="th">CD0</text><text class="th">CDi</text>
      </view>
      <view class="tr" wx:for="{{resultRows}}" wx:key="name">
        <text class="td {{item.target ? 'target' : ''}}">{{item.name}}</text>
        <text class="td {{item.target ? 'target' : ''}}">{{item.ld}}</text>
        <text class="td">{{item.CD0}}</text>
        <text class="td">{{item.CDi}}</text>
      </view>
    </block>
  </view>

  <view class="panel">
    <view class="panel-head">军推输出 · THRUST</view>
    <view class="note">{{thrustStatusText}}</view>
    <block wx:if="{{thrustResult}}">
      <view class="stat-row">
        <view class="stat"><view class="k">可用军推</view><view class="v">{{thrustKN}} kN</view><view class="sub">{{thrustTf}} 吨力</view></view>
        <view class="stat"><view class="k">推力衰减 α</view><view class="v amber">{{thrustAlpha}}</view></view>
        <view class="stat"><view class="k">质量流比</view><view class="v">{{thrustMdot}}</view></view>
        <view class="stat"><view class="k">风扇压比</view><view class="v">{{thrustFanPr}}</view></view>
      </view>
      <view class="note">{{thrustNote}}</view>
    </block>
  </view>

  <view class="panel">
    <view class="panel-head">效率 / TSFC 输出</view>
    <view class="note">{{effStatusText}}</view>
    <block wx:if="{{effResult}}">
      <view class="stat-row">
        <view class="stat"><view class="k">负载比</view><view class="v amber">{{effLoadPct}}%</view><view class="sub">原始 {{effLoadRawPct}}%</view></view>
        <view class="stat"><view class="k">总效率 η_o</view><view class="v">{{effEtaO}}%</view><view class="sub">热 {{effEtaTh}}% · 推进 {{effEtaP}}%</view></view>
        <view class="stat"><view class="k">TSFC</view><view class="v">{{effTsfc}}</view><view class="sub">{{effTsfcLb}}</view></view>
        <view class="stat"><view class="k">反解 T4</view><view class="v">{{effT4}} K</view></view>
      </view>
      <view class="note">{{effNote}}</view>
    </block>
  </view>

  <view class="panel">
    <view class="panel-head">作战半径输出 · RANGE</view>
    <view class="note">{{radiusStatusText}}</view>
    <block wx:if="{{radiusResult}}">
      <view class="stat-row">
        <view class="stat"><view class="k">马赫角</view><view class="v">{{radiusAngle}}</view></view>
        <view class="stat"><view class="k">最大巡航 Ma</view><view class="v amber">{{radiusMaxMach}}</view><view class="sub">{{radiusMass}}</view></view>
      </view>
      <view class="note" wx:if="{{radiusFuel}}">{{radiusFuel}} · {{radiusReserve}}</view>
      <view class="note" wx:if="{{radiusClimb}}">{{radiusClimb}} · {{radiusDescent}}</view>
      <view class="tr th">
        <text class="th">点</text><text class="th">Ma</text><text class="th">半径km</text><text class="th">kg/km</text>
      </view>
      <view class="tr" wx:for="{{radiusRows}}" wx:key="label">
        <block wx:if="{{item.ok}}">
          <text class="td target">{{item.label}}</text>
          <text class="td target">{{item.mach}}</text>
          <text class="td">{{item.radius}}</text>
          <text class="td">{{item.sfc}}</text>
        </block>
        <block wx:else>
          <text class="td">{{item.label}}</text>
          <text class="td">{{item.mach}}</text>
          <text class="td">{{item.detail}}</text>
          <text class="td">—</text>
        </block>
      </view>
      <view class="note">{{radiusNote}}</view>
    </block>
  </view>

  <view class="panel">
    <view class="panel-head">最大速度输出 · Vmax</view>
    <view class="note">{{maxSpeedStatusText}}</view>
    <block wx:if="{{maxSpeedResult}}">
      <view class="stat-row">
        <view class="stat"><view class="k">最大速度</view><view class="v amber">{{maxSpeedKmh}} km/h</view><view class="sub">Ma {{maxSpeedMach}}</view></view>
        <view class="stat"><view class="k">最佳高度</view><view class="v">{{maxSpeedAlt}} km</view></view>
      </view>
      <view class="tr th">
        <text class="th">高度km</text><text class="th">Ma</text><text class="th">km/h</text><text class="th">负载%</text>
      </view>
      <view class="tr" wx:for="{{maxSpeedProfileRows}}" wx:key="altKm">
        <text class="td">{{item.altKm}}</text>
        <text class="td">{{item.mach}}</text>
        <text class="td">{{item.vKmh}}</text>
        <text class="td">{{item.loadPct}}</text>
      </view>
      <view class="note">{{maxSpeedNote}}</view>
    </block>
  </view>
</view>
