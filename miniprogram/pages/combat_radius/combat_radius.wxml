<view class="cr-page">
  <view class="cr-header">
    <text class="cr-title">飞机作战半径估算终端</text>
    <text class="cr-sub">COMBAT RADIUS · 预计算仪表盘 + 按需搜索</text>
  </view>
  <view class="note">{{statusText}}</view>

  <view class="panel">
    <view class="panel-head">选择战机 · INPUT</view>
    <view class="note">选择机型后自动填充参数并加载预计算结果。修改任意机型或发动机参数后，点「计算作战半径」按当前参数重算各速度下的整张表（也会在停止输入后自动重算）。</view>
    <view class="field">
      <view class="field-label"><text>机型</text></view>
      <picker mode="selector" range="{{presetNames}}" value="{{tgtPresetIndex}}" bindchange="onAircraftPreset">
        <view class="picker-val">{{presetNames[tgtPresetIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>展弦比 AR</text><text class="unit">计算</text></view>
      <view class="input input-readonly">{{tgt.AR || '—'}}</view>
    </view>
    <view class="field">
      <view class="field-label"><text>前缘后掠角</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{tgt.sweep_deg}}" data-key="sweep_deg" bindinput="onAcField"/>
    </view>
    <view class="field" wx:if="{{tgt.planform === 'double_delta'}}">
      <view class="field-label"><text>内段前缘后掠</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{tgt.sweep_inner_deg}}" data-key="sweep_inner_deg" bindinput="onAcField"/>
    </view>
    <view class="field" wx:if="{{tgt.planform === 'double_delta'}}">
      <view class="field-label"><text>外段前缘后掠</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{tgt.sweep_outer_deg}}" data-key="sweep_outer_deg" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼载荷</text><text class="unit">t/m² · 计算</text></view>
      <view class="input input-readonly">{{tgt.wing_loading || '—'}}</view>
    </view>
    <view class="field">
      <view class="field-label"><text>厚弦比 tc</text></view>
      <input class="input" type="digit" value="{{tgt.tc}}" data-key="tc" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>进气道</text></view>
      <picker mode="selector" range="{{inletNames}}" value="{{inletIndex}}" bindchange="onInletPreset">
        <view class="picker-val">{{inletNames[inletIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>挂装方式</text></view>
      <picker mode="selector" range="{{storeMountNames}}" value="{{storeMountIndex}}" bindchange="onStoreMountPreset">
        <view class="picker-val">{{storeMountNames[storeMountIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>翼面积</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{tgt.wing_area_m2}}" data-key="wing_area_m2" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>马赫角</text><text class="unit">°</text></view>
      <input class="input" type="digit" value="{{tgt.mach_angle_deg}}" data-key="mach_angle_deg" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机身长度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.length_m}}" data-key="length_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>翼展</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.wingspan_m}}" data-key="wingspan_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机身宽</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.fuse_width_m}}" data-key="fuse_width_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机身高</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.fuse_height_m}}" data-key="fuse_height_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机头锥长度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.nose_cone_length_m}}" data-key="nose_cone_length_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机头锥直径</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.nose_cone_diameter_m}}" data-key="nose_cone_diameter_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机头长度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.nose_length_m}}" data-key="nose_length_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机头根部直径</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.nose_root_diameter_m}}" data-key="nose_root_diameter_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>机身盒段长度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{tgt.fuse_body_length_m}}" data-key="fuse_body_length_m" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>主翼面积（单面）</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{tgt.main_wing_area_m2}}" data-key="main_wing_area_m2" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>平尾/鸭翼面积（单面）</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{tgt.canard_htail_area_m2}}" data-key="canard_htail_area_m2" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>垂尾面积（单面）</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{tgt.vtail_area_m2}}" data-key="vtail_area_m2" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>腹鳍面积（单面）</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{tgt.ventral_fin_area_m2}}" data-key="ventral_fin_area_m2" bindinput="onAcField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>空重</text><text class="unit">kg</text></view>
      <input class="input" type="digit" value="{{wtEmpty}}" data-key="wtEmpty" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>内油</text><text class="unit">kg</text></view>
      <input class="input" type="digit" value="{{wtFuel}}" data-key="wtFuel" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>飞行员数</text></view>
      <input class="input" type="number" value="{{wtPilots}}" data-key="wtPilots" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>单枚中距弹</text><text class="unit">kg</text></view>
      <input class="input" type="digit" value="{{wtMissile}}" data-key="wtMissile" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>挂弹数</text></view>
      <input class="input" type="number" value="{{wtNMissiles}}" data-key="wtNMissiles" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>发动机台数</text></view>
      <input class="input" type="number" value="{{wtEngines}}" data-key="wtEngines" bindinput="onField"/>
    </view>
    <view class="check-row">
      <label><switch checked="{{wtCarrier}}" bindchange="onCarrierSwitch"/> 舰载弹射 45 min；垂起与陆基 30 min</label>
    </view>
    <view class="section cyan">▸ 发动机</view>
    <view class="field">
      <view class="field-label"><text>发动机预设</text></view>
      <picker mode="selector" range="{{engineNames}}" value="{{enginePresetIndex}}" bindchange="onEnginePreset">
        <view class="picker-val">{{engineNames[enginePresetIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>涵道比 BPR</text></view>
      <input class="input" type="digit" value="{{engBpr}}" data-key="engBpr" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>总压比 OPR</text></view>
      <input class="input" type="digit" value="{{engOpr}}" data-key="engOpr" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>涡轮前温度 T4</text><text class="unit">K</text></view>
      <input class="input" type="digit" value="{{engT4}}" data-key="engT4" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>海平面军推</text><text class="unit">kN</text></view>
      <input class="input" type="digit" value="{{engTsl}}" data-key="engTsl" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>海平面加力</text><text class="unit">kN</text></view>
      <input class="input" type="digit" value="{{engMaxTsl}}" data-key="engMaxTsl" bindinput="onField"/>
    </view>
    <view wx:if="{{showF135TsfcToggle}}">
      <view class="section amber">▸ F135 油耗惩罚</view>
      <view class="seg">
        <view class="seg-btn {{f135TsfcMode === 'published' ? 'on' : ''}}" data-mode="published" bindtap="onF135TsfcMode">{{f135TsfcPublishedLabel}}</view>
        <view class="seg-btn {{f135TsfcMode === 'lpc_only' ? 'on' : ''}}" data-mode="lpc_only" bindtap="onF135TsfcMode">{{f135TsfcLpcLabel}}</view>
      </view>
      <view class="note">{{f135TsfcNote}}</view>
    </view>
    <view class="btn" bindtap="onRunDash">▶ 计算作战半径</view>
  </view>

  <view class="panel">
    <view class="panel-head">包线与作战半径 · DASHBOARD</view>
    <view class="note">{{dashStatusText}}</view>
    <block wx:if="{{dashOk}}">
      <view class="stat-row">
        <view class="stat"><view class="k">实用最大巡航速度</view><view class="v amber">{{dashMaxCruise}}</view></view>
        <view class="stat"><view class="k">最大巡航速度</view><view class="v">{{dashMaxPossibleCruise}}</view></view>
        <view class="stat"><view class="k">极速</view><view class="v">{{dashVmax}}</view></view>
      </view>
      <view class="tr th">
        <text class="th">速度/马赫</text><text class="th">最大L/D</text><text class="th">半径km</text><text class="th">混合km</text>
      </view>
      <view class="tr" wx:for="{{dashRows}}" wx:key="label">
        <text class="td {{item.ok ? 'target' : ''}}">{{item.mach}}</text>
        <text class="td">{{item.maxLd}}</text>
        <text class="td">{{item.radius}}</text>
        <text class="td">{{item.mixed}}</text>
      </view>
      <view class="note">表尾「实用最大巡航速度」在 Ma 1.2 以上取最佳巡航高度达到最大值时的速度；「最大巡航速度」允许掉到 11 km。若与 Ma 1.2 以上作战半径最大的马赫不同，再插一行「最大半径超音速巡航速度」。混合作战半径仅超音速：去程该马赫、返程 Ma 0.8。最佳巡航高度使升阻比×总效率最大。最大 L/D 为可飞高度（军推优先，不足则加力）中升阻比最大的点；加力可飞按全部加力，高度可到海平面。极速按阻力等于全部加力（不留巡航裕度）；超过超巡带后附加体积波阻，避免光滑隐身机靠降高把极速估高。</view>
    </block>
  </view>

  <view class="panel">
    <view class="panel-head">给定速度 · 搜索最佳升阻比与巡航高度</view>
    <view class="field">
      <view class="field-label"><text>马赫数</text></view>
      <input class="input" type="digit" value="{{q1Mach}}" data-key="q1Mach" bindinput="onField"/>
    </view>
    <view class="btn" bindtap="onRunSearchCruise">▶ 搜索最佳升阻比和巡航高度</view>
    <view class="note">{{q1Text}}</view>
    <block wx:if="{{q1Rows.length}}">
      <view class="tr scan th">
        <text class="th">高度km</text>
        <text class="th">升阻比</text>
        <text class="th">推力kN</text>
        <text class="th">负载</text>
        <text class="th">热效率</text>
        <text class="th">推进效率</text>
        <text class="th">总效率</text>
      </view>
      <view class="tr scan" wx:for="{{q1Rows}}" wx:key="key">
        <text class="td {{item.best ? 'target' : (item.ok ? '' : 'miss')}}">{{item.alt}}</text>
        <text class="td {{item.best ? 'target' : (item.ok ? '' : 'miss')}}">{{item.ld}}</text>
        <text class="td {{item.best ? 'target' : (item.ok ? '' : 'miss')}}">{{item.thrust}}</text>
        <text class="td {{item.best ? 'target' : (item.ok ? '' : 'miss')}}">{{item.load}}</text>
        <text class="td {{item.best ? 'target' : (item.ok ? '' : 'miss')}}">{{item.etaTh}}</text>
        <text class="td {{item.best ? 'target' : (item.ok ? '' : 'miss')}}">{{item.etaP}}</text>
        <text class="td {{item.best ? 'target' : (item.ok ? '' : 'miss')}}">{{item.etaO}}</text>
      </view>
      <view class="note">绿行是该速度下升阻比×总效率最大的高度；灰行不满足 92% 军推裕度。</view>
    </block>
  </view>

  <view class="panel">
    <view class="panel-head">给定速度与高度</view>
    <view class="field">
      <view class="field-label"><text>马赫数</text></view>
      <input class="input" type="digit" value="{{q2Mach}}" data-key="q2Mach" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>高度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{q2Alt}}" data-key="q2Alt" bindinput="onField"/>
    </view>
    <view class="btn" bindtap="onRunPoint">▶ 计算该点升阻比与效率</view>
    <view class="note">{{q2Text}}</view>
  </view>

  <view class="panel">
    <view class="panel-head">给定速度、高度、负载 · 发动机效率</view>
    <view class="field">
      <view class="field-label"><text>马赫数</text></view>
      <input class="input" type="digit" value="{{q3Mach}}" data-key="q3Mach" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>高度</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{q3Alt}}" data-key="q3Alt" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>负载</text></view>
      <input class="input" type="digit" value="{{q3Load}}" data-key="q3Load" bindinput="onField"/>
    </view>
    <view class="btn" bindtap="onRunEngineCycle">▶ 计算发动机热/推进/总效率</view>
    <view class="note">{{q3Text}}</view>
  </view>
</view>
