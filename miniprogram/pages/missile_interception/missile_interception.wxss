page {
  background: #05080a;
  color: #d7e2e4;
  font-family: Courier New, monospace;
  min-height: 100vh;
}
.sat-page {
  padding: 24rpx;
  background-image:
    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 56rpx 56rpx;
}
.sat-header { margin-bottom: 24rpx; border-bottom: 1px solid #1c2b30; padding-bottom: 16rpx; }
.sat-title { display: block; color: #ffb020; letter-spacing: 4rpx; font-size: 28rpx; }
.sat-sub { display: block; color: #7b8e92; font-size: 20rpx; margin-top: 8rpx; }
.panel {
  background: #0b1216; border: 1px solid #1c2b30; padding: 24rpx; margin-bottom: 24rpx;
}
.panel-head { color: #7b8e92; font-size: 20rpx; letter-spacing: 2rpx; margin-bottom: 16rpx; }
.section { color: #7b8e92; font-size: 20rpx; margin: 20rpx 0 12rpx; padding-top: 16rpx; border-top: 1px dashed #1c2b30; }
.section.red { color: #ff4d4f; }
.section.green { color: #3ddc84; }
.section.cyan { color: #5fd8e8; }
.field { margin-bottom: 20rpx; }
.field-label { display: flex; justify-content: space-between; color: #7b8e92; font-size: 22rpx; margin-bottom: 8rpx; }
.unit { color: #5fd8e8; }
.input, .picker-val {
  background: #0e161b; border: 1px solid #1c2b30; color: #d7e2e4; padding: 14rpx 16rpx; font-size: 26rpx;
}
.input[disabled] { color: #3ddad0; background: #0b1216; }
.btn {
  background: #ffb020; color: #1a1300; text-align: center; padding: 20rpx; font-weight: bold;
  letter-spacing: 4rpx; margin-top: 12rpx; font-size: 26rpx;
}
.btn.cyan { background: #5fd8e8; color: #04262b; }
.btn[disabled] { opacity: 0.55; }
.note { color: #7b8e92; font-size: 20rpx; line-height: 1.6; margin-top: 12rpx; }
.stat-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 20rpx; }
.stat { flex: 1; min-width: 180rpx; background: #0e161b; border: 1px solid #1c2b30; padding: 16rpx; }
.stat .k { color: #7b8e92; font-size: 18rpx; }
.stat .v { color: #ffb020; font-size: 40rpx; margin-top: 8rpx; }
.stat .v.red { color: #ff4d4f; }
.stat .v.green { color: #3ddc84; }
.stat .sub { color: #7b8e92; font-size: 18rpx; }
.table { width: 100%; font-size: 20rpx; }
.tr { display: flex; border-bottom: 1px solid #1c2b30; padding: 10rpx 0; }
.th { color: #7b8e92; }
.td { color: #d7e2e4; flex: 1; }
.td.best { color: #3ddc84; }
.td.worse { color: #ff4d4f; }
.hint-q {
  margin-left: 8rpx; width: 28rpx; height: 28rpx; line-height: 28rpx;
  text-align: center; border: 1px solid #1c2b30; color: #5fd8e8; font-size: 20rpx;
}
.field-range { color: #7b8e92; font-size: 18rpx; margin-top: 6rpx; }
.stale-banner {
  margin-bottom: 16rpx; padding: 12rpx 16rpx; font-size: 22rpx; color: #ffb020;
  border: 1px solid #7a5a1e; background: rgba(255,176,32,0.08);
}
.back-to-top {
  position: fixed; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 40; padding: 12rpx 20rpx; background: #0b1216; color: #5fd8e8;
  border: 1px solid #5fd8e8; font-size: 22rpx;
}
.chart-wrap { width: 100%; height: 280rpx; margin-top: 12rpx; }
