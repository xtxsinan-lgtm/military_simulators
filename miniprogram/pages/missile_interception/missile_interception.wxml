<view class="sat-page">
  <view class="sat-header">
    <text class="sat-title">饱和打击 / 反导拦截仿真终端</text>
    <text class="sat-sub">SHIPBORNE MISSILE INTERCEPTION</text>
  </view>

  <view class="panel">
    <view class="panel-head">参数输入 · INPUT</view>

    <view class="field">
      <view class="field-label">
        <text>来袭导弹数量</text>
        <text class="hint-q" data-key="nm" bindtap="onHint">?</text>
        <text class="unit">枚</text>
      </view>
      <input class="input" type="digit" value="{{nm}}" data-key="nm" bindinput="onField"/>
      <view class="field-range" wx:if="{{ranges.nm}}">范围 {{ranges.nm.min}}–{{ranges.nm.max}} 枚</view>
    </view>
    <view class="field">
      <view class="field-label"><text>拦截弹数量</text><text class="unit">枚</text></view>
      <input class="input" type="number" value="{{ni}}" data-key="ni" bindinput="onField"/>
    </view>

    <view class="section red">▸ 打击方</view>
    <view class="field">
      <view class="field-label"><text>反舰导弹国别</text></view>
      <picker mode="selector" range="{{asmNationNames}}" value="{{asmNationIndex}}" bindchange="onAsmNation">
        <view class="picker-val">{{asmNationNames[asmNationIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>反舰导弹型号</text></view>
      <picker mode="selector" range="{{asmNames}}" value="{{asmIndex}}" bindchange="onAsmPreset">
        <view class="picker-val">{{asmNames[asmIndex] || '自定义'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>导弹速度</text><text class="hint-q" data-key="vm" bindtap="onHint">?</text><text class="unit">Ma</text></view>
      <input class="input" type="digit" value="{{vm}}" data-key="vm" bindinput="onField"/>
      <view class="field-range" wx:if="{{ranges.vm}}">范围 {{ranges.vm.min}}–{{ranges.vm.max}} Ma</view>
    </view>
    <view class="field">
      <view class="field-label"><text>RCS</text><text class="hint-q" data-key="rcs" bindtap="onHint">?</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{rcs}}" data-key="rcs" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>弹道类型</text><text class="hint-q" data-key="traj" bindtap="onHint">?</text></view>
      <picker mode="selector" range="{{trajNames}}" value="{{trajIndex}}" bindchange="onTraj">
        <view class="picker-val">{{trajNames[trajIndex]}}</view>
      </picker>
    </view>

    <view class="section cyan">▸ 预警机</view>
    <view class="field">
      <view class="field-label"><text>预警机预设</text></view>
      <picker mode="selector" range="{{aewNames}}" value="{{aewIndex}}" bindchange="onAewPreset">
        <view class="picker-val">{{aewNames[aewIndex] || '自定义'}}</view>
      </picker>
      <view class="note" wx:if="{{!hasAwacs}}">已选择「无预警机」：发现距离退化为仅取决于舰载雷达（功率/视距取小），下方预警机字段不参与计算。</view>
    </view>
    <view class="field">
      <view class="field-label"><text>天线面积</text><text class="hint-q" data-key="awacsArea" bindtap="onHint">?</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{awacsArea}}" data-key="awacsArea" bindinput="onField"/>
      <view class="field-range" wx:if="{{ranges.awacsArea}}">范围 {{ranges.awacsArea.min}}–{{ranges.awacsArea.max}} m²</view>
    </view>
    <view class="field">
      <view class="field-label"><text>雷达体制</text><text class="hint-q" data-key="awacsType" bindtap="onHint">?</text></view>
      <picker mode="selector" range="{{radarTypeNames}}" value="{{awacsTypeIndex}}" bindchange="onAwacsType">
        <view class="picker-val">{{radarTypeNames[awacsTypeIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>前出距离</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{standoff}}" data-key="standoff" bindinput="onField"/>
    </view>

    <view class="section green">▸ 舰载雷达 & 拦截弹</view>
    <view class="field">
      <view class="field-label"><text>防御方国别</text><text class="unit">同时限制舰艇与防空弹</text></view>
      <picker mode="selector" range="{{defenderNationNames}}" value="{{defenderNationIndex}}" bindchange="onDefenderNation">
        <view class="picker-val">{{defenderNationNames[defenderNationIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>驱护舰艇型号</text></view>
      <picker mode="selector" range="{{shipNames}}" value="{{shipIndex}}" bindchange="onShipPreset">
        <view class="picker-val">{{shipNames[shipIndex] || '自定义'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>防空导弹型号</text></view>
      <picker mode="selector" range="{{samNames}}" value="{{samIndex}}" bindchange="onSamPreset">
        <view class="picker-val">{{samNames[samIndex] || '自定义'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>舰载天线面积</text><text class="hint-q" data-key="shipArea" bindtap="onHint">?</text><text class="unit">m²</text></view>
      <input class="input" type="digit" value="{{shipArea}}" data-key="shipArea" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>舰载雷达体制</text></view>
      <picker mode="selector" range="{{radarTypeNames}}" value="{{shipTypeIndex}}" bindchange="onShipType">
        <view class="picker-val">{{radarTypeNames[shipTypeIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>拦截弹射程</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{samRange}}" data-key="samRange" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>拦截弹最大射高</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{samMaxAlt}}" data-key="samMaxAlt" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>拦截弹速度</text><text class="unit">Ma</text></view>
      <input class="input" type="digit" value="{{vi}}" data-key="vi" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>拦截弹直径</text><text class="hint-q" data-key="interceptorDia" bindtap="onHint">?</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{interceptorDia}}" data-key="interceptorDia" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>制导头体制</text><text class="hint-q" data-key="seekerType" bindtap="onHint">?</text></view>
      <picker mode="selector" range="{{seekerNames}}" value="{{seekerIndex}}" bindchange="onSeeker">
        <view class="picker-val">{{seekerNames[seekerIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>火控锁定时间</text><text class="unit">s</text></view>
      <input class="input" type="digit" value="{{tlock}}" data-key="tlock" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>最小交战距离</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{minr}}" data-key="minr" bindinput="onField"/>
    </view>

    <view class="btn cyan" bindtap="onEstimateDistanceAndPk">◈ 估算交战距离与拦截率</view>
    <view class="note">{{distNote}}</view>
    <view class="note">{{pkNote}}</view>
    <view class="note">交战距离 = min( max(预警机, 舰载), 拦截弹射程 [, 俯冲进入距离] )。仅当巡航高度高于拦截弹最大射高时才计入俯冲几何；常规高空/掠海导弹已在射高包线内，不涉及俯冲角。</view>

    <view class="field">
      <view class="field-label"><text>预警机雷达探测距离</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{awacsDetectKm}}" disabled="true" placeholder="待估算"/>
    </view>
    <view class="field">
      <view class="field-label"><text>舰载雷达探测距离</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{shipDetectKm}}" disabled="true" placeholder="待估算"/>
    </view>
    <view class="field">
      <view class="field-label"><text>进入有效射高距离</text><text class="unit">估算</text></view>
      <input class="input" value="{{diveEntryDisplay}}" disabled="true"/>
    </view>
    <view class="field">
      <view class="field-label"><text>交战距离</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{discoveryKm}}" data-key="discoveryKm" bindinput="onField"/>
    </view>
    <view class="field">
      <view class="field-label"><text>单发拦截成功概率</text><text class="hint-q" data-key="pk" bindtap="onHint">?</text><text class="unit">0–1</text></view>
      <input class="input" type="digit" value="{{pk}}" data-key="pk" bindinput="onField"/>
    </view>

    <view class="btn" bindtap="onRun">{{running ? (statusTag === 'QUEUED' ? '已排队…' : '计算中…') : '▶ 运行仿真'}}</view>
    <view class="note">{{statusText}}</view>
  </view>

  <view class="panel" wx:if="{{hasResult}}">
    <view class="panel-head">仿真结果 · {{statusTag}}</view>
    <view class="stale-banner" wx:if="{{resultStale}}">参数已更改，以下结果与当前输入不一致，请重新仿真。</view>
    <view class="stat-row">
      <view class="stat"><view class="k">拦截窗口数</view><view class="v">{{statRounds}}</view><view class="sub">{{statRoundsSub}}</view></view>
      <view class="stat"><view class="k">期望突防</view><view class="v red">{{statLeak}}</view><view class="sub">{{statLeakSub}}</view></view>
      <view class="stat"><view class="k">期望拦截率</view><view class="v green">{{statRate}}</view><view class="sub">{{statRateSub}}</view></view>
    </view>

    <view class="section">▸ 拦截窗口</view>
    <view class="table">
      <view class="tr th"><text class="td">窗口</text><text class="td">起始km</text><text class="td">飞时s</text><text class="td">耗时s</text><text class="td">末距km</text></view>
      <view class="tr" wx:for="{{windows}}" wx:key="round">
        <text class="td">#{{item.round}}</text>
        <text class="td">{{item.dist_start_km}}</text>
        <text class="td">{{item.t_fly_s}}</text>
        <text class="td">{{item.total_t_s}}</text>
        <text class="td">{{item.dist_end_km}}</text>
      </view>
    </view>

    <view class="section">▸ 最优弹药分配</view>
    <view class="table">
      <view class="tr th"><text class="td">窗口</text><text class="td">预算</text><text class="td">轮初存活</text><text class="td">枚/目标</text><text class="td">杀伤%</text></view>
      <view class="tr" wx:for="{{planRows}}" wx:key="round">
        <text class="td">#{{item.round}}</text>
        <text class="td">{{item.budget}}</text>
        <text class="td">{{item.surv}}</text>
        <text class="td">{{item.per}}</text>
        <text class="td">{{item.kill}}</text>
      </view>
    </view>

    <view class="section">▸ 存活曲线</view>
    <canvas type="2d" id="survivorCanvas" class="chart-wrap" style="width:100%;height:140px;"></canvas>

    <view class="section">▸ 策略对比</view>
    <view class="table">
      <view class="tr th"><text class="td">策略</text><text class="td">分配</text><text class="td">突防</text><text class="td">相对最优</text></view>
      <view class="tr" wx:for="{{strategies}}" wx:key="name">
        <text class="td {{item.best ? 'best' : ''}}">{{item.name}}</text>
        <text class="td {{item.best ? 'best' : ''}}">{{item.plan}}</text>
        <text class="td {{item.best ? 'best' : ''}}">{{item.leak}}</text>
        <text class="td {{item.best ? 'best' : 'worse'}}">{{item.relative}}</text>
      </view>
    </view>
    <view class="note">{{finalNote}}</view>
  </view>
  <view class="back-to-top" wx:if="{{showBackToTop}}" bindtap="onBackToTop">↑ 顶部</view>
</view>
