<view class="mr-page">
  <text class="mr-title">导弹射程估算终端</text>
  <text class="mr-sub">RANGE · HGV / RAM / CRUISE / BALLISTIC</text>

  <view class="panel">
    <view class="panel-head">弹体与发射条件 · INPUT</view>
    <text class="note">{{classBlurb}}</text>
    <view class="field">
      <view class="field-label"><text>弹种</text></view>
      <picker mode="selector" range="{{classNames}}" value="{{classIndex}}" bindchange="onPickClass">
        <view class="picker-val">{{classNames[classIndex] || '加载中…'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>预设样本</text></view>
      <picker mode="selector" range="{{caseNames}}" value="{{caseIndex}}" bindchange="onPickCase">
        <view class="picker-val">{{caseNames[caseIndex] || '加载中…'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text>弹长</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{lengthM}}" data-key="lengthM" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label"><text>弹径</text><text class="unit">m</text></view>
      <input class="input" type="digit" value="{{diameterM}}" data-key="diameterM" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label"><text>战斗部</text><text class="unit">kg</text></view>
      <input class="input" type="digit" value="{{warheadKg}}" data-key="warheadKg" bindinput="onInput" />
    </view>
    <view class="section cyan">▸ 发射条件</view>
    <view class="field">
      <view class="field-label"><text>发射马赫数</text></view>
      <input class="input" type="digit" value="{{vMach}}" data-key="vMach" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label"><text>发射高度</text><text class="unit">km</text></view>
      <input class="input" type="digit" value="{{hKm}}" data-key="hKm" bindinput="onInput" />
    </view>
    <view class="section amber">▸ 推进剂</view>
    <view class="field">
      <view class="field-label"><text>固体比冲</text><text class="unit">s</text></view>
      <input class="input" type="digit" value="{{ispS}}" data-key="ispS" bindinput="onInput" />
    </view>
    <view class="field" wx:if="{{showAirIsp}}">
      <view class="field-label"><text>吸气比冲</text><text class="unit">s</text></view>
      <input class="input" type="digit" value="{{ispAir}}" data-key="ispAir" bindinput="onInput" />
    </view>
    <view class="field" wx:if="{{showBallisticSingleStage}}">
      <view class="field-label"><text>仅单级</text><text class="unit">{{ballisticSingleStage ? '锁定' : '搜索'}}</text></view>
      <switch checked="{{ballisticSingleStage}}" bindchange="onBallisticSingleStageChange" color="#3ddc84" />
    </view>
    <view class="field" wx:if="{{showOptimizeGeometry}}">
      <view class="field-label"><text>寻优滑翔体</text><text class="unit">{{optimizeGeometry ? '开' : '关'}}</text></view>
      <switch checked="{{optimizeGeometry}}" bindchange="onOptimizeGeometryChange" color="#3ddc84" />
    </view>
    <view class="field">
      <view class="field-label"><text>密度</text><text class="unit">kg/m³</text></view>
      <input class="input" type="digit" value="{{density}}" data-key="density" bindinput="onInput" />
    </view>
    <view class="btn" bindtap="onRun">▶ 估算射程</view>
  </view>

  <view class="panel">
    <view class="panel-head">估算结果 · OUTPUT</view>
    <view class="status">{{statusText}}</view>
    <view class="takeover-alert" wx:if="{{result && result.reached_takeover === false}}">
      <view class="takeover-badge">⚠️ 未达工作速度 (TAKEOVER FAILED)</view>
      <view class="takeover-desc">助推级实际加速至 Ma {{result.mach_boost || result.v_burnout_mach}}，低于冲压发动机设计接力速度 Ma {{result.mach_takeover}}。冲压未启动，巡航段有效射程为 0 km，当前射程仅计助推关机后的纯惯性弹道滑行弧。</view>
    </view>
    <view class="takeover-meter" wx:if="{{result && result.mach_takeover != null}}">
      <view class="takeover-meter-head">
        <text>助推接力进度</text>
        <text>Ma {{result.mach_boost || result.v_burnout_mach}} / {{result.mach_takeover}}</text>
      </view>
      <view class="bar-bg">
        <view class="bar-fill {{result.reached_takeover === false ? 'fail' : ''}}" style="width: {{takeoverPct}}%;"></view>
      </view>
      <text class="takeover-meter-cap">{{result.reached_takeover === false ? '未达接力速度，冲压未启动' : '已接入冲压巡航'}} · {{takeoverPct}}%</text>
    </view>
    <view class="stat-row" wx:if="{{result && result.mach_takeover != null}}">
      <view class="stat"><view class="k">接力目标速度</view><view class="v">Ma {{result.mach_takeover}}</view></view>
      <view class="stat"><view class="k">助推实际速度</view><view class="v {{result.reached_takeover === false ? 'red' : 'amber'}}">Ma {{result.mach_boost || result.v_burnout_mach}}</view></view>
      <view class="stat"><view class="k">冲压工作状态</view><view class="v {{result.reached_takeover === false ? 'red' : ''}}">{{result.reached_takeover === false ? '未启动' : '已接入'}}</view></view>
      <view class="stat" wx:if="{{result.m_booster_kg != null}}"><view class="k">助推器全重 kg</view><view class="v amber">{{result.m_booster_kg}}</view></view>
    </view>
    <view class="stat-row" wx:if="{{result && result.profileText}}">
      <view class="stat"><view class="k">高空/混合/掠海 km</view><view class="v">{{result.profileText}}</view></view>
    </view>
    <view class="stat-row" wx:if="{{result && result.alt_range_text}}">
      <view class="stat"><view class="k">各机射程 km</view><view class="v">{{result.alt_range_text}}</view></view>
    </view>
    <view class="stat-row" wx:if="{{result && result.range_sea_km == null}}">
      <view class="stat"><view class="k">{{result.reached_takeover === false ? '弹道滑行 km' : '估算射程 km'}}</view><view class="v {{result.reached_takeover === false ? 'amber' : ''}}">{{result.range_km}}</view></view>
      <view class="stat" wx:if="{{result.n_stages != null}}"><view class="k">助推分级</view><view class="v">{{result.stageText || (result.n_stages === 1 ? '单级' : (result.n_stages === 2 ? '两级 ' + result.stage_split : '三级 ' + result.stage_split))}}</view></view>
      <view class="stat"><view class="k">{{result.reached_takeover === false ? '关机马赫' : '马赫'}}</view><view class="v {{result.reached_takeover === false ? 'red' : 'amber'}}">{{result.v_burnout_mach}}</view></view>
    </view>
    <view class="stat-row" wx:if="{{result && result.m_wing_kg != null}}">
      <view class="stat"><view class="k">折叠弹翼 kg</view><view class="v">{{result.m_wing_kg}}</view></view>
      <view class="stat"><view class="k">死重 kg</view><view class="v amber">{{result.m_dead_kg}}</view></view>
    </view>
    <view class="stat-row" wx:if="{{result}}">
      <view class="stat"><view class="k">升阻比</view><view class="v">{{result.ld_ratio}}</view></view>
      <view class="stat"><view class="k">起飞质量 t</view><view class="v amber">{{result.m_0_t}}</view></view>
    </view>
    <view class="stat-row" wx:if="{{result}}">
      <view class="stat"><view class="k">弹头 m</view><view class="v">{{result.l_head_m}}</view></view>
      <view class="stat" wx:if="{{result.d_head_m != null}}"><view class="k">滑翔径 m</view><view class="v">{{result.d_head_m}}</view></view>
      <view class="stat" wx:if="{{result.fineness != null}}"><view class="k">长细比</view><view class="v">{{result.fineness}}</view></view>
      <view class="stat" wx:if="{{result.range_gain_km != null && result.range_gain_km > 0}}"><view class="k">几何增程 km</view><view class="v">{{result.range_gain_km}}</view></view>
      <view class="stat"><view class="k">助推 m</view><view class="v">{{result.l_booster_m}}</view></view>
      <view class="stat"><view class="k">推进剂 kg</view><view class="v">{{result.m_p_total_kg}}</view></view>
    </view>
    <view class="stat-row" wx:if="{{result && (result.isp_cruise_s != null || result.isp_boost_s != null || result.isp_rocket_s != null)}}">
      <view class="stat" wx:if="{{result.isp_boost_s != null}}"><view class="k">助推比冲 s</view><view class="v">{{result.isp_boost_s}}</view></view>
      <view class="stat" wx:if="{{result.isp_cruise_s != null}}"><view class="k">吸气比冲 s</view><view class="v amber">{{result.isp_cruise_s}}</view></view>
      <view class="stat" wx:if="{{result.isp_rocket_s != null}}"><view class="k">固体比冲 s</view><view class="v">{{result.isp_rocket_s}}</view></view>
    </view>
    <text class="note" wx:if="{{result && result.note}}">{{result.note}}</text>
  </view>

  <view class="panel">
    <view class="panel-head">预设样本表 · TABLE</view>
    <view class="field">
      <view class="field-label"><text>只看未达工作速度</text><text class="unit red">{{failCount}} 发</text></view>
      <switch checked="{{failOnly}}" bindchange="onFailOnlyChange" color="#ff4d4f" />
    </view>
    <text class="note">冲压接力：已接入 {{okCount}} 发 · 未达工作速度 {{failCount}} 发。点红色标签查看弹道弧射程。</text>
    <scroll-view scroll-x class="scroll-x">
      <view class="table">
        <view class="tr th">
          <text class="col">ID</text>
          <text class="col bay">载机</text>
          <text class="col wide">尺寸</text>
          <text class="col wh">战斗部重量</text>
          <text class="col">弹种</text>
          <text class="col wide">射程</text>
          <text class="col">分级</text>
          <text class="col alt">各机射程</text>
        </view>
        <view class="tr {{item.id === activeId ? 'on' : ''}} {{item.reached_takeover === false ? 'fail-takeover' : ''}}" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapRow">
          <text class="td col">{{item.id}}</text>
          <text class="td col bay">{{item.bay || '—'}}</text>
          <text class="td col wide">{{item.size_m}}</text>
          <text class="td col wh">{{item.warhead_kg}}</text>
          <text class="td col">{{item.kind}}<text class="tag-alert" wx:if="{{item.reached_takeover === false}}">未达速</text></text>
          <text class="td col wide">{{item.profileText || item.range_km}}</text>
          <text class="td col">{{item.stageText}}</text>
          <text class="td col alt">{{item.altText}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
