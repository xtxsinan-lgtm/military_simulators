page {
  background: #05080a;
  color: #d7e2e4;
  font-family: Courier New, monospace;
  min-height: 100vh;
}
.mr-page {
  padding: 24rpx;
  background-image:
    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 56rpx 56rpx;
}
.mr-title { display: block; color: #3ddc84; letter-spacing: 4rpx; font-size: 28rpx; }
.mr-sub { display: block; color: #7b8e92; font-size: 20rpx; margin: 8rpx 0 24rpx; }
.panel {
  background: #0b1216; border: 1px solid #1c2b30; padding: 24rpx; margin-bottom: 24rpx;
}
.panel-head { color: #7b8e92; font-size: 20rpx; letter-spacing: 2rpx; margin-bottom: 16rpx; }
.section { color: #7b8e92; font-size: 20rpx; margin: 20rpx 0 12rpx; padding-top: 16rpx; border-top: 1px dashed #1c2b30; }
.section.cyan { color: #5fd8e8; }
.section.amber { color: #ffb020; }
.field { margin-bottom: 20rpx; }
.field-label { display: flex; justify-content: space-between; color: #7b8e92; font-size: 22rpx; margin-bottom: 8rpx; }
.unit { color: #5fd8e8; }
.input, .picker-val {
  background: #0e161b; border: 1px solid #1c2b30; color: #d7e2e4; padding: 14rpx 16rpx; font-size: 26rpx;
}
.btn {
  background: #3ddc84; color: #042014; text-align: center; padding: 20rpx; font-weight: bold;
  letter-spacing: 4rpx; margin-top: 12rpx; font-size: 26rpx;
}
.btn[disabled] { opacity: 0.55; }
.note { color: #7b8e92; font-size: 20rpx; line-height: 1.6; margin-bottom: 16rpx; }
.stat-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 12rpx; }
.stat { flex: 1; min-width: 180rpx; background: #0e161b; border: 1px solid #1c2b30; padding: 16rpx; }
.stat .k { color: #7b8e92; font-size: 18rpx; }
.stat .v { color: #3ddc84; font-size: 36rpx; margin-top: 8rpx; }
.stat .v.amber { color: #ffb020; }
.status { color: #3ddc84; font-size: 22rpx; margin-bottom: 12rpx; }
.tr { display: flex; border-bottom: 1px solid #1c2b30; padding: 12rpx 0; font-size: 22rpx; }
.th { color: #7b8e92; }
.td { color: #d7e2e4; flex: 1; }
.tr.on .td { color: #ffb020; }
.scroll-x { overflow-x: auto; }
.table { min-width: 1180rpx; }
.col { width: 110rpx; flex: none; }
.col.wh { width: 160rpx; }
.col.isp { width: 200rpx; }
.col.wide { width: 220rpx; }
.col.bay { width: 220rpx; }

.stat .v.red { color: #ff4d4f; }
.takeover-alert {
  background: rgba(255, 77, 79, 0.12);
  border: 1px solid #ff4d4f;
  border-left: 6rpx solid #ff4d4f;
  padding: 16rpx;
  margin-bottom: 20rpx;
}
.takeover-badge {
  color: #ff4d4f;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.takeover-desc {
  color: #d7e2e4;
  font-size: 22rpx;
  line-height: 1.5;
}
.tag-alert {
  display: inline-block;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  background: rgba(255, 77, 79, 0.2);
  border: 1px solid #ff4d4f;
  color: #ff4d4f;
  margin-left: 6rpx;
}
.unit.red { color: #ff4d4f; }
.tr.fail-takeover .td { color: #ff4d4f; }
.takeover-meter {
  background: #0e161b;
  border: 1px solid #1c2b30;
  padding: 16rpx;
  margin-bottom: 20rpx;
}
.takeover-meter-head {
  display: flex;
  justify-content: space-between;
  color: #7b8e92;
  font-size: 20rpx;
  margin-bottom: 10rpx;
}
.takeover-meter-cap {
  display: block;
  color: #7b8e92;
  font-size: 20rpx;
  margin-top: 8rpx;
}
.bar-bg {
  height: 12rpx;
  background: #1c2b30;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: #3ddc84;
}
.bar-fill.fail { background: #ff4d4f; }

